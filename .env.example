FTP_PUBLIC_IP=changeme
FTP_PORT=21
SFTP_PORT=2222
FTP_ENABLED=true
SFTP_ENABLED=true
FTP_PASSIVE_PORT_RANGE=50000-50999
# FTP_TLS_CERT=/etc/ftp/tls.crt
# FTP_TLS_KEY=/etc/ftp/tls.key
COS_STATIC_SECRET_ID=changeme
COS_STATIC_SECRET_KEY=changeme
COS_STATIC_SESSION_TOKEN=changeme

# Storage backends. Each user picks one when created (and it can't be changed
# later). STORAGE_BACKEND is the default for users that don't choose.
#   cos.objectstorage.plugin    Tencent COS
#   local.objectstorage.plugin  local disk under STORAGE_LOCAL_ROOT
STORAGE_BACKEND=cos.objectstorage.plugin
# Backends users can be assigned to: cos, local, or cos,local. Empty = only the default.
STORAGE_ENABLED_BACKENDS=
STORAGE_LOCAL_ROOT=/data

COS_BUCKET=changeme
COS_REGION=changeme

PUBLIC_URL=http://localhost:9001

OIDC_ISSUER_URL=https://iam.central.tech/realms/master
OIDC_CLIENT_ID=changeme
OIDC_CLIENT_SECRET=changeme
OIDC_ADMIN_GROUP=cds-fileserver-admin
OIDC_READONLY_GROUP=cds-fileserver-user
OIDC_FRONTEND_REDIRECT_URL=/auth/callback

FTP_DEFAULT_ROOT_PREFIX=/t/t/

# Local development admin. Change this password before using a shared host.
ADMIN_LOCAL_LOGIN=true
FTP_SEED=true
FTP_SEED_USER=localadmin
FTP_SEED_PASS=ChangeMe123

# Workflow file events
FILE_EVENTS_ENABLED=true
FILE_EVENTS_MIME_SNIFF_MODE=fallback
FILE_EVENTS_MIME_SNIFF_MAX_BYTES=8388608
FILE_EVENT_RETENTION_DAYS=30

# Workflow service. Leave WORKFLOW_API_URL empty to disable the workflow UI proxy.
WORKFLOW_API_URL=
WORKFLOW_SERVICE_TOKEN=dev-workflow-token

# Workflow notifications (optional)
WORKFLOW_SMTP_HOST=
WORKFLOW_SMTP_PORT=587
WORKFLOW_SMTP_USER=
WORKFLOW_SMTP_PASS=
WORKFLOW_SMTP_FROM=
WORKFLOW_SMTP_TLS=starttls
WORKFLOW_WEBHOOK_ALLOW_PRIVATE=false
# Allow plain http:// webhook targets (https only when false). Dev/testing only.
WORKFLOW_WEBHOOK_ALLOW_HTTP=false
