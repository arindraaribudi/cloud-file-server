{
  "name": "cloud-file-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "bun --cwd apps/web run dev",
    "dev:ftp": "bun run apps/ftp/Makefile -- run",
    "dev:workflow": "cd apps/workflow && go run ./cmd/workflow-server",
    "build:web": "bun --cwd apps/web run build",
    "build:workflow": "cd apps/workflow && go build -o bin/workflow-server ./cmd/workflow-server",
    "build": "bun run build:web",
    "typecheck": "bun --cwd apps/web run typecheck && (cd apps/ftp && go vet ./...) && (cd apps/workflow && go vet ./...)",
    "test:ftp": "cd apps/ftp && go test -race ./...",
    "test:workflow": "cd apps/workflow && go test -race ./...",
    "lint:ftp": "cd apps/ftp && golangci-lint run ./...",
    "lint:workflow": "cd apps/workflow && golangci-lint run ./...",
    "fmt:ftp": "cd apps/ftp && go fmt ./...",
    "fmt:workflow": "cd apps/workflow && go fmt ./..."
  },
  "engines": { "bun": "1.4.0" }
}
